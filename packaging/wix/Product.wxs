<?xml version="1.0" encoding="utf-8"?>
<!--
  Product definition for msitools/wixl (Linux) and WiX Toolset (Windows).
  File list is generated by wixl-heat over artifacts/payload (see packaging/build.sh).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="Group Policy Director"
      Language="1031"
      Version="0.1.0"
      Manufacturer="Group Policy Director"
      UpgradeCode="A7C3E9F1-4B2D-4E8A-9C1F-6D5B8A0E2F34">

    <Package
        InstallerVersion="200"
        Compressed="yes"
        InstallScope="perMachine"
        Description="Group Policy Director API, UI and Worker (win-x64 self-contained)"
        Comments="Rough lab installer. Intune deferred."
        Manufacturer="Group Policy Director" />

    <MajorUpgrade
        DowngradeErrorMessage="Eine neuere Version von Group Policy Director ist bereits installiert." />

    <Media Id="1" Cabinet="gpd.cab" EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="Group Policy Director" Level="1">
      <ComponentGroupRef Id="ProductFiles" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Group Policy Director" />
      </Directory>
    </Directory>

    <!--
      Windows services: after msiexec, run elevated PowerShell:
        & 'C:\Program Files\Group Policy Director\scripts\Install-Gpd.ps1'
      Or use ZIP + scripts\Setup-Gpd.ps1.
    -->
  </Product>
</Wix>
