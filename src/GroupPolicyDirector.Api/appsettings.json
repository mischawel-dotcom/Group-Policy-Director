{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "UseNegotiate": false
  },
  "ConnectionStrings": {
    "Gpd": "Server=localhost;Database=GroupPolicyDirector;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Smtp": {
    "Host": "",
    "Port": 25,
    "From": "gpd-noreply@contoso.local",
    "UseSsl": false
  },
  "Oob": {
    "AlertRecipients": [ "gpd-admins@contoso.local" ],
    "ScanIntervalSeconds": 300
  }
}
